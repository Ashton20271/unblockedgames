
async function loadFiles() {
    const container = document.getElementById("links");
    container.textContent = "Loading games...";

    const [filenames, analytics] = await Promise.all([
        fetch("filenames.txt").then(res => res.text()),
        fetchGameAnalytics().catch(err => {
            console.warn("Unable to load game analytics", err);
            return null;
        }),
    ]);

    const lines = filenames.split(/\r?\n/);
    const games = [];

    lines.forEach(file => {
        file = file.trim();
        if (!file) return;

        if (
            file.toLowerCase().endsWith(".html") ||
            file.toLowerCase().endsWith(".htm")
        ) {
            const display = file.replace(/\.(html|htm)$/i, "").replace(/^cl/i, "");
            const pageKey = `/${file}`;
            const stats = analytics && analytics[pageKey] ? analytics[pageKey] : { pageviews: 0, visitors: 0 };

            games.push({ file, display, stats });
        }
    });

    games.sort((a, b) => {
        const visitorsDiff = b.stats.visitors - a.stats.visitors;
        if (visitorsDiff !== 0) return visitorsDiff;
        const pageviewsDiff = b.stats.pageviews - a.stats.pageviews;
        if (pageviewsDiff !== 0) return pageviewsDiff;
        return a.display.localeCompare(b.display, undefined, { numeric: true, sensitivity: 'base' });
    });

    container.innerHTML = "";

    games.forEach(game => {
        const a = document.createElement("a");
        a.href = game.file;
        a.textContent = `${game.display} · Plays: ${game.stats.visitors.toLocaleString()} · Views: ${game.stats.pageviews.toLocaleString()}`;

        if (game.file.toLowerCase() === "chatroom.html") {
            a.className = "chatroom-link";
        }

        container.appendChild(a);
    });
}

async function fetchGameAnalytics() {
    const url = "https://simpleanalytics.com/unblockedgames6767.vercel.app.json?version=6&start=today&end=today&fields=pages&info=false";
    const res = await fetch(url);
    if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);

    const data = await res.json();
    if (!data.ok) throw new Error("Analytics response returned ok=false");
    if (!Array.isArray(data.pages)) throw new Error("Analytics response missing pages data");

    return data.pages.reduce((map, page) => {
        if (typeof page.value === 'string') {
            map[page.value] = {
                pageviews: Number(page.pageviews) || 0,
                visitors: Number(page.visitors) || 0,
            };
        }
        return map;
    }, {});
}

function searchGames() {
    const input = document.getElementById("searchInput").value.toLowerCase();
    const links = document.querySelectorAll("#links a");

    links.forEach(link => {
        link.style.display =
            link.textContent.toLowerCase().includes(input)
            ? "block"
            : "none";
    });
}

async function loadGitHubUpdates() {
    const list = document.getElementById("github-updates");

    try {
        const res = await fetch("https://api.github.com/repos/ashton20271/unblockedgames/commits?per_page=5");
        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);

        const commits = await res.json();
        list.innerHTML = "";

        if (!Array.isArray(commits) || commits.length === 0) {
            list.innerHTML = "<li>No recent updates found.</li>";
            return;
        }

        commits.forEach(commit => {
            const li = document.createElement("li");
            const message = commit.commit && commit.commit.message
                ? commit.commit.message.split("\n")[0]
                : "No commit message";
            const date = commit.commit && commit.commit.author && commit.commit.author.date
                ? new Date(commit.commit.author.date).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" })
                : "Unknown date";
            const author = commit.commit && commit.commit.author && commit.commit.author.name
                ? commit.commit.author.name
                : (commit.author && commit.author.login) || "Unknown author";

            const span = document.createElement("span");
            span.textContent = message;

            const meta = document.createElement("div");
            meta.textContent = `${date}`;
            meta.style.fontSize = "0.85rem";
            meta.style.color = "#bbb";
            meta.style.marginTop = "4px";

            li.appendChild(span);
            li.appendChild(meta);
            list.appendChild(li);
        });
    } catch (err) {
        list.innerHTML = "<li>Unable to load updates.</li>";
        console.error("load updates failed:", err);
    }
}

async function loadSimpleAnalyticsStats() {
    const list = document.getElementById("sa-stats");
    const url = "https://simpleanalytics.com/unblockedgames6767.vercel.app.json?version=6&fields=pageviews,visitors&start=today&end=today&info=false";

    try {
        const res = await fetch(url);
        if (!res.ok) throw new Error(`${res.status} ${res.statusText}`);

        const data = await res.json();
        if (!data.ok) throw new Error("Analytics response returned ok=false");

        list.innerHTML = "";
        const period = document.createElement("li");
        period.textContent = `Period: ${new Date(data.start).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}`;
        list.appendChild(period);

        const pageviews = document.createElement("li");
        pageviews.textContent = `Page views: ${data.pageviews.toLocaleString()}`;
        list.appendChild(pageviews);

        const visitors = document.createElement("li");
        visitors.textContent = `Visitors: ${data.visitors.toLocaleString()}`;
        list.appendChild(visitors);
    } catch (err) {
        list.innerHTML = "<li>Unable to load stats. This is likely caused by using an adblocker.</li>";
        console.error("load stats failed:", err);
    }
}

loadFiles();
loadGitHubUpdates();
loadSimpleAnalyticsStats();

